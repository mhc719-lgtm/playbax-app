<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Circular In-App PlayBax Emblem matching the exact static state of PlayBaxSplashView -->
    <path
        android:pathData="M24,0 A24,24 0 1,1 23.99,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="48"
                android:endY="48">
                <item android:offset="0.0" android:color="#FF1744" />
                <item android:offset="0.38" android:color="#FF3D00" />
                <item android:offset="0.75" android:color="#FF6D00" />
                <item android:offset="1.0" android:color="#FF9100" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 295° Replay Arc with Rounded Cap (ringR = 13.92, strokeWidth = 3.48, -90° to 205°) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M24,10.08 A13.92,13.92 0 1,1 11.38,18.12"
        android:strokeWidth="3.48"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Replay Arrowhead at 12 o'clock -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M19.90,10.08 L26.05,6.66 L26.05,13.50 Z" />

    <!-- Center Play Triangle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M20.70,18.90 L29.70,24.0 L20.70,29.10 Z" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      PlayBax Modern Google Soft Gradient Adaptive Foreground:
      - Generous white breathing room inside the 66dp circle mask: X=35..73 (38dp wide), Y=30..78 (48dp tall)
      - Single soft-pillowed vertical replay screen silhouette with Google-style folded top-right corner
      - Smooth multi-stop soft linear + radial gradients (#1A73E8 -> #4285F4 -> #669DF6 -> #7BAAF7 / #5CE1E6)
      - Crisp minimalist white Delayed-Play prism + cascading replay echo inside
    -->

    <!-- Main Soft-Rounded Replay Screen Silhouette -->
    <path
        android:pathData="M43,30 L61,30 L73,42 L73,70 C73,74.4 69.4,78 65,78 L43,78 C38.6,78 35,74.4 35,70 L35,38 C35,33.6 38.6,30 43,30 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="35"
                android:startY="30"
                android:endX="74"
                android:endY="78">
                <item android:offset="0.0" android:color="#1A73E8" />
                <item android:offset="0.48" android:color="#4285F4" />
                <item android:offset="0.80" android:color="#669DF6" />
                <item android:offset="1.0" android:color="#7BAAF7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft Bottom-Right Pastel Radial Glow (Google Workspace / Photos soft luminance) -->
    <path
        android:pathData="M43,30 L61,30 L73,42 L73,70 C73,74.4 69.4,78 65,78 L43,78 C38.6,78 35,74.4 35,70 L35,38 C35,33.6 38.6,30 43,30 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="68"
                android:centerY="72"
                android:gradientRadius="28">
                <item android:offset="0.0" android:color="#99A8C7FA" />
                <item android:offset="1.0" android:color="#004285F4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top-Right Soft Folded Corner Flap -->
    <path
        android:pathData="M61,30 L73,42 L65,42 C62.8,42 61,40.2 61,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="61"
                android:startY="30"
                android:endX="73"
                android:endY="42">
                <item android:offset="0.0" android:color="#174EA6" />
                <item android:offset="1.0" android:color="#1967D2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft Tonal Delayed-Echo Bar (Left Cascade Indicator) -->
    <path
        android:fillColor="#B3E8F0FE"
        android:pathData="M43.5,48 C44.6,48 45.5,48.9 45.5,50 L45.5,62 C45.5,63.1 44.6,64 43.5,64 C42.4,64 41.5,63.1 41.5,62 L41.5,50 C41.5,48.9 42.4,48 43.5,48 Z" />

    <!-- Crisp White Soft-Rounded Play Prism (Delayed Playback Symbol) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M49.5,47.8 C49.5,46.3 51.2,45.4 52.5,46.2 L63.2,53.2 C64.4,54.0 64.4,56.0 63.2,56.8 L52.5,63.8 C51.2,64.6 49.5,63.7 49.5,62.2 Z" />

    <!-- Subtle Soft Recording / Live Delay Dot (Top-Left Badge Accent) -->
    <path
        android:fillColor="#E8F0FE"
        android:pathData="M43.5,39.5 A2.0,2.0 0 1,1 43.49,39.5 Z" />
</vector>
